# Run: python scripts/init_env.py  (generates real local secrets)
SESSION_SIGNING_KEY=REPLACE_WITH_GENERATED_SESSION_SIGNING_KEY
MASTER_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_MASTER_ENCRYPTION_KEY
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Defaults to a local SQLite file; point at Postgres for a real pilot deployment
# e.g. postgresql+asyncpg://user:password@host:5432/sales_copilot
DATABASE_URL=

# Optional, required for actual microphone transcription
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# Optional, Sarvam AI streaming Speech-to-Text for Indian languages & Hinglish.
# Set STT_PROVIDER=sarvam to use it instead of Deepgram for live mic/Twilio transcription.
STT_PROVIDER=deepgram
SARVAM_API_KEY=
SARVAM_LANGUAGE=hi-IN

# Optional, Twilio Voice + Media Streams integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_DEFAULT_TO=

# Optional, WhatsApp call recaps (requires a Twilio WhatsApp sender + an approved
# Content Template — see README "WhatsApp recap"). Reps opt in from Settings.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEMPLATE_SID=
PUBLIC_BASE_URL=

# Optional, required for model-generated hints and semantic vector retrieval
OPENAI_API_KEY=
OPENAI_HINT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
