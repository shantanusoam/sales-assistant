# Run: python scripts/init_env.py  (generates real local demo secrets)
DEMO_ACCESS_CODE=REPLACE_WITH_GENERATED_DEMO_ACCESS_CODE
SESSION_SIGNING_KEY=REPLACE_WITH_GENERATED_SESSION_SIGNING_KEY
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional, required for actual microphone transcription
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# Optional, Sarvam AI Speech-to-Text for Indian languages & Hinglish
SARVAM_API_KEY=

# Optional, Twilio Voice + Media Streams integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_DEFAULT_TO=
PUBLIC_BASE_URL=

# Optional, required for model-generated hints and semantic vector retrieval
OPENAI_API_KEY=
OPENAI_HINT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
